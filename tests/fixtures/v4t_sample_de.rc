// German copy of V4T.rc, as it has existed since 2016.
//
// Not generated by anything. Somebody copied the English file, replaced the
// strings by hand, and it has been edited apart from the English ever since.
// This is what the adopt operation reads.

#include "resource.h"

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_BARCODE_PROPS DIALOGEX 0, 0, 316, 214
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Barcode-Eigenschaften"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Barcode-Liste:",IDC_STATIC,7,7,49,8
    LTEXT           "Balkenhöhe",IDC_STATIC,163,26,36,8
    EDITTEXT        IDC_BAR_HEIGHT,205,24,40,14,ES_AUTOHSCROLL
    LTEXT           "Breite",IDC_STATIC,163,45,20,8
    EDITTEXT        IDC_BAR_WIDTH,205,43,40,14,ES_AUTOHSCROLL
    CONTROL         "Klarschrift",IDC_HUMAN_READABLE,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,163,64,68,10
    CONTROL         "Auto parity",IDC_AUTO_PARITY,"Button",BS_AUTOCHECKBOX |
                    WS_TABSTOP,163,80,60,10
    LTEXT           "Trägerdicke",IDC_STATIC,163,99,56,8
    LTEXT           "Modulgröße",IDC_STATIC,163,118,40,8
    GROUPBOX        "Weitere Optionen",IDC_STATIC,156,7,153,140
    PUSHBUTTON      "Variable Daten",IDC_ADD_VARIABLE,7,160,84,16
    LTEXT           "Dieser Abstand darf nicht größer als der Druckabstand sein",
                    IDC_HINT,7,182,240,20,SS_LEFTNOWORDWRAP
    DEFPUSHBUTTON   "OK",IDOK,205,192,50,16
    PUSHBUTTON      "Abbrechen",IDCANCEL,259,192,50,16
    LTEXT           "Nur im deutschen Build",IDC_GERMAN_ONLY,7,206,120,8
    CONTROL         "",IDC_PREVIEW,"Static",SS_BLACKFRAME,7,20,140,130
    CONTROL         IDB_TOOLBAR,IDC_TOOLBAR_IMAGE,"Static",SS_BITMAP,7,7,16,16
END

