    IDS_PRINT_STARTED       "Druck gestartet"
    IDS_SERVICE_RESTARTED   "Dienst neu gestartet"
    IDS_SERVICE_NOT_RESTART "Dienst nicht neu gestartet"
    IDS_FEATURE_OFF         "Funktion ist nicht aktiviert"
    IDS_FIRING_RANGE        "Bitte von %.1fV bis %.1fV eingeben."
    IDS_LENGTH_LIMIT        "Die Länge muss kleiner als <V1> Zeichen sein"
    IDS_VALUE_RANGE         "Wert muss zwischen <V1> und <V2> liegen"
    IDS_NO_CHANGE_PRINTING  "Parameter kann während des Drucks nicht geändert werden"
    IDS_PURGE_OFFSET        "Bereinigungsversatz muss kleiner als "
                            "Gruppenversatz sein"
    IDS_MCR_RESTART         "Bitte Software neu starten, um MCR zu verbinden."
    IDS_UNITS_MM            "mm"
